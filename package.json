{
  "name": "mslsc-shell",
  "productName": "MSLSC",
  "private": true,
  "version": "0.4.2",
  "description": "A desktop shell that loads the live MSLSC systems inside one window instead of a dozen browser tabs.",
  "author": "Midway Surf Lifesaving Club",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish always",
    "dist:linux": "electron-builder --linux --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "nz.org.mslsc.shell",
    "publish": {
      "provider": "github",
      "owner": "midwaysurfbar",
      "repo": "mslsc-shell",
      "releaseType": "release"
    },
    "productName": "MSLSC",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MSLSC"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
